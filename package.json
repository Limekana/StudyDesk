{
  "name": "studydesk",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "license": "MIT",
  "author": "Limecore Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Limekana/StudyDesk.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "electron:dev": "electron .",
    "electron:build": "npm run build && node electron/build.cjs --win && npm run electron:zip",
    "electron:zip": "node electron/package-zip.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@supabase/supabase-js": "^2.106.0",
    "@vercel/analytics": "^2.0.1",
    "i18next": "^23.16.8",
    "lucide-react": "^0.414.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^14.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "sharp": "^0.35.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.limecore.studydesk.desktop",
    "productName": "StudyDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "StudyDesk-Desktop-Setup-${version}.${ext}"
    }
  }
}
