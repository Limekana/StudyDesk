<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.1.1 — Android 12+ data extraction opt-out.

    Replaces android:fullBackupContent on API 31+. Covers two surfaces:
      - cloud-backup    Google Drive Auto Backup.
      - device-transfer Direct device-to-device migration during phone setup.

    StudyDesk stores academic data (subjects, grades, study sessions,
    GPA history, outbox) in WebView localStorage. None of that should
    leave the device without an explicit user action. Excluding every
    domain on both surfaces is the safest default.

    Pairs with android:allowBackup="false" and the legacy
    android:fullBackupContent="@xml/backup_rules" for Android < 12.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
