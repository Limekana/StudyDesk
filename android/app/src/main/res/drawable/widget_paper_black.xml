<?xml version="1.0" encoding="utf-8"?>
<!-- v1.15 — widget_paper for the black palette. Same page and margin-rule
     geometry as widget_paper.xml; only the colours differ, taken from the app's
     own [data-mode="black"] tokens (modes.css) so the widget matches the app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
            <stroke android:width="1dp" android:color="#2A2620" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:left="26dp"
        android:top="13dp"
        android:bottom="13dp"
        android:width="1dp"
        android:gravity="left|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#6E3A33" />
        </shape>
    </item>
</layer-list>
