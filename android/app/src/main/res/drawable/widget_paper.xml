<?xml version="1.0" encoding="utf-8"?>
<!-- v1.10 — the widget surface: a page out of StudyDesk's notebook.

     Replaces the plain bordered rectangle of 1.7.0. The margin rule is the
     point: it is the app's signature, and a vertical red line with the content
     set to its right is recognisable as StudyDesk from across a home screen in
     a way a cream rounded rectangle is not.

     Hardcoded colours, as the background it replaces was — a widget is
     inflated by the launcher process and inherits none of the app's theme. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The page. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FAF8F4" />
            <stroke android:width="1dp" android:color="#E0D9CF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- The margin rule. Inset top and bottom so it stops short of the rounded
         corners rather than colliding with them — a ruled page's margin does
         not run into the edge either.

         android:width + android:gravity on a layer-list item is API 23; minSdk
         here is 24. -->
    <item
        android:left="26dp"
        android:top="13dp"
        android:bottom="13dp"
        android:width="1dp"
        android:gravity="left|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#E3A49C" />
        </shape>
    </item>
</layer-list>
