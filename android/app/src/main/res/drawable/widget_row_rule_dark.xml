<?xml version="1.0" encoding="utf-8"?>
<!-- v1.15 — widget_row_rule for the dark palette. See widget_row_rule.xml for
     why the stroke is pushed off-canvas on three sides. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="-1dp"
        android:left="-1dp"
        android:right="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#2A261E" />
        </shape>
    </item>
</layer-list>
