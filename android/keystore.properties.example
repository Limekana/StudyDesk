# keystore.properties.example — safe to commit, no real values
# To use: copy to keystore.properties and fill in values from your secure credentials store.
# keystore.properties is in .gitignore and must never be committed.

storeFile=C:\\path\\to\\your.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
