# Copy to .env (or .env.local / .env.production) and fill in to point the
# build at a different Supabase project. Both vars are optional — if unset,
# the build falls back to the canonical StudyDesk public project.
#
# These are PUBLIC keys (Supabase anon / publishable key — RLS gates data).
# Never put the service_role key in a Vite env — that's a server-only secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
